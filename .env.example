# SkyTalk server — copy to .env and fill in values before running

# Required: plaintext tutor password (bcrypt-hashed at startup, never logged)
SKYTALK_TUTOR_PASSWORD=change-me

# Required: JWT signing secret, minimum 32 characters
SKYTALK_JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Required: public-facing base URL (no trailing slash), used to build room URLs
SKYTALK_PUBLIC_URL=https://skytalk.example.com

# Required: shared HMAC secret between this server and coturn (lt-cred-mech)
SKYTALK_TURN_SECRET=change-me-to-coturn-shared-secret

# Optional: SQLite database file path (default: /var/lib/skytalk/skytalk.db)
# SKYTALK_DB_PATH=/var/lib/skytalk/skytalk.db

# Optional: server bind address and port (defaults: 127.0.0.1, 3001)
# HOST=127.0.0.1
# PORT=3001
